<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>Hyperlight.Wasm.Tests</RootNamespace>
    <!-- The tests call overloads without a CancellationToken on purpose. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    <RepoRoot>$(MSBuildThisFileDirectory)../../../</RepoRoot>
    <!-- Use the generator from this repository instead of the package layout. -->
    <HyperlightBindgenTaskAssembly>$(MSBuildThisFileDirectory)../../src/Hyperlight.Wasm.Build/bin/$(Configuration)/net10.0/Hyperlight.Wasm.Build.dll</HyperlightBindgenTaskAssembly>
    <HyperlightBindgenLibrary>$(HyperlightNativeDir)$(HyperlightNativePrefix)hyperlight_wasm_csharp_bindgen$(HyperlightNativeSuffix)</HyperlightBindgenLibrary>
  </PropertyGroup>

  <Import Project="../../src/Hyperlight.Wasm.Build/build/Hyperlight.Wasm.Build.props" />

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Hyperlight.Wasm/Hyperlight.Wasm.csproj" />
    <ProjectReference Include="../../src/Hyperlight.Wasm.Build/Hyperlight.Wasm.Build.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The build creates the runtime and compiles the component that `just build-rust-component-examples` builds. -->
  <ItemGroup>
    <HyperlightWit Include="$(RepoRoot)src/tests/rust_guests/component_sample/wit/" World="example" Namespace="Hyperlight.Wasm.Tests.Sample" Runtime="component-sample-runtime" />
    <HyperlightComponent Include="$(RepoRoot)src/tests/rust_guests/component_sample/target/wasm32-unknown-unknown/$(HyperlightCargoProfile)/component_sample.wasm" />
  </ItemGroup>

  <Import Project="../../src/Hyperlight.Wasm.Build/build/Hyperlight.Wasm.Build.targets" />

</Project>
